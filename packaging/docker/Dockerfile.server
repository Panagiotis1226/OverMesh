# OverMesh control plane image (server + web UI + STUN + relay).
# Build from the repo root:
#   docker build -t overmesh-server -f packaging/docker/Dockerfile.server .
FROM golang:1.25-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags "-s -w" -o /overmesh-server ./cmd/overmesh-server

FROM alpine:3.20
RUN apk add --no-cache ca-certificates
COPY --from=build /overmesh-server /usr/bin/overmesh-server
VOLUME /var/lib/overmesh-server
# HTTP/web UI, gRPC coordination, STUN
EXPOSE 8080/tcp 41641/tcp 41643/tcp 3478/udp
ENTRYPOINT ["/usr/bin/overmesh-server", "-state-dir", "/var/lib/overmesh-server"]
